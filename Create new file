    function triggerConfetti() {
      const canvas = document.getElementById("confetti-canvas");
      if (!canvas) return;
      const ctx = canvas.getContext("2d");
      
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;

      const particles = [];
      const colors = ['#0284c7', '#4f46e5', '#10b981', '#f59e0b', '#ec4899'];

      for (let i = 0; i < 45; i++) {
        particles.push({
          x: window.innerWidth / 2,
          y: window.innerHeight / 2,
          vx: (Math.random() - 0.5) * 14,
          vy: (Math.random() - 0.7) * 14,
          size: Math.random() * 6 + 4,
          color: colors[Math.floor(Math.random() * colors.length)],
          alpha: 1,
          decay: Math.random() * 0.02 + 0.015
        });
      }

      function animate() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        let active = false;

        particles.forEach(p => {
          if (p.alpha > 0) {
            active = true;
            p.x += p.vx;
            p.y += p.vy;
            p.vy += 0.2; // gravity
            p.alpha -= p.decay;

            ctx.save();
            ctx.globalAlpha = Math.max(0, p.alpha);
            ctx.fillStyle = p.color;
            ctx.fillRect(p.x, p.y, p.size, p.size);
            ctx.restore();
          }
        });

        if (active) {
          requestAnimationFrame(animate);
        } else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
      }

      animate();
    }

    function setupExportHandlers() {
      // PDF Export
      document.getElementById('btn-export-pdf').addEventListener('click', () => {
        const element = document.getElementById('export-container');
        
        // Update PDF info header
        document.getElementById('pdf-export-date').innerText = new Date().toLocaleDateString('zh-TW');
        const compCount = state.goals.filter(g => g.completed).length;
        document.getElementById('pdf-export-progress').innerText = `${compCount} / ${state.goals.length} (${Math.round((compCount/state.goals.length)*100)}%)`;

        const opt = {
          margin:       0.3,
          filename:     `2027年100項必做事項與盤點報告_${new Date().toISOString().split('T')[0]}.pdf`,
          image:        { type: 'jpeg', quality: 0.98 },
          html2canvas:  { scale: 2, useCORS: true },
          jsPDF:        { unit: 'in', format: 'a4', orientation: 'portrait' }
        };

        // Reveal notes temporarily for export
        document.querySelectorAll('[id^="note-container-"]').forEach(el => el.classList.remove('hidden'));

        showToast("正在生成 PDF 報告，請稍候...", "info");

        html2pdf().set(opt).from(element).save().then(() => {
          renderGoals(); // Restore dynamic UI view
          showToast("PDF 報告下載完成！", "success");
        }).catch(err => {
          console.error(err);
          showToast("PDF 匯出失敗，請重試", "error");
        });
      });

      // JSON Export
      document.getElementById('btn-export-json').addEventListener('click', () => {
        const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(state, null, 2));
        const downloadAnchor = document.createElement('a');
        downloadAnchor.setAttribute("href", dataStr);
        downloadAnchor.setAttribute("download", `2027_Goals_Backup_${new Date().toISOString().split('T')[0]}.json`);
        document.body.appendChild(downloadAnchor);
        downloadAnchor.click();
        downloadAnchor.remove();
        showToast("JSON 備份檔已開始下載", "success");
      });

      // JSON Import
      const importBtn = document.getElementById('btn-import-json');
      const importInput = document.getElementById('input-import-file');

      importBtn.addEventListener('click', () => importInput.click());

      importInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = (event) => {
          try {
            const importedState = JSON.parse(event.target.result);
            if (importedState && Array.isArray(importedState.goals)) {
              state = importedState;
              saveState();
              initReflectionFields();
              renderGoals();
              showToast("資料備份匯入成功！", "success");
            } else {
              showToast("匯入的 JSON 檔案格式不不符！", "error");
            }
          } catch (err) {
            showToast("讀取檔案失敗：" + err.message, "error");
          }
        };
        reader.readAsText(file);
      });
    }

    function initReflectionFields() {
      const ach = document.getElementById('reflection-achievements');
      const lea = document.getElementById('reflection-learnings');
      const let = document.getElementById('reflection-letter');

      if (state.reflections) {
        ach.value = state.reflections.achievements || "";
        lea.value = state.reflections.learnings || "";
        let.value = state.reflections.letter || "";
      }

      ach.addEventListener('input', (e) => {
        state.reflections.achievements = e.target.value;
        saveState();
      });
      lea.addEventListener('input', (e) => {
        state.reflections.learnings = e.target.value;
        saveState();
      });
      let.addEventListener('input', (e) => {
        state.reflections.letter = e.target.value;
        saveState();
      });
    }

    function initCategoryDropdowns() {
      const catFilter = document.getElementById("category-filter");
      const modalCat = document.getElementById("modal-category");

      Object.keys(CATEGORIES).forEach(key => {
        const cat = CATEGORIES[key];
        
        const opt1 = document.createElement("option");
        opt1.value = key;
        opt1.textContent = `${cat.name}`;
        catFilter.appendChild(opt1);

        const opt2 = document.createElement("option");
        opt2.value = key;
        opt2.textContent = `${cat.name}`;
        modalCat.appendChild(opt2);
      });
    }

    function setupModalAndTheme() {
      // Custom Goal Modal
      const modal = document.getElementById("modal-add");
      const btnAdd = document.getElementById("btn-add-custom");
      const btnClose = document.getElementById("btn-close-modal");
      const btnCancel = document.getElementById("btn-cancel-modal");
      const btnSave = document.getElementById("btn-save-custom");

      const openModal = () => modal.classList.remove("hidden");
      const closeModal = () => {
        modal.classList.add("hidden");
        document.getElementById("modal-title").value = "";
      };

      btnAdd.addEventListener("click", openModal);
      btnClose.addEventListener("click", closeModal);
      btnCancel.addEventListener("click", closeModal);

      btnSave.addEventListener("click", () => {
        const title = document.getElementById("modal-title").value.trim();
        const category = document.getElementById("modal-category").value;

        if (!title) {
          showToast("請輸入項目名稱！", "error");
          return;
        }

        const newId = state.goals.length > 0 ? Math.max(...state.goals.map(g => g.id)) + 1 : 1;
        state.goals.push({
          id: newId,
          category: category,
          title: title,
          completed: false,
          completedDate: "",
          note: ""
        });

        saveState();
        renderGoals();
        closeModal();
        showToast("自訂目標項目已成功新增！", "success");
      });

      // Dark Mode Toggle
      const themeBtn = document.getElementById("theme-toggle");
      themeBtn.addEventListener("click", () => {
        document.documentElement.classList.toggle("dark");
        renderCanvasStats();
      });
    }

    function showToast(message, type = 'info') {
      const container = document.getElementById("toast-container");
      if (!container) return;

      const toast = document.createElement("div");
      
      let iconClass = "fa-circle-info text-sky-500";
      let bgClass = "bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-100";

      if (type === 'success') {
        iconClass = "fa-circle-check text-emerald-500";
      } else if (type === 'error') {
        iconClass = "fa-circle-exclamation text-rose-500";
      }

      toast.className = `flex items-center space-x-3 px-4 py-3 rounded-xl shadow-xl border ${bgClass} text-sm transition-all duration-300 pointer-events-auto toast-enter`;
      toast.innerHTML = `
        <i class="fa-solid ${iconClass} text-base"></i>
        <span class="font-medium">${message}</span>
      `;

      container.appendChild(toast);

      // Trigger animation
      setTimeout(() => {
        toast.classList.remove("toast-enter");
        toast.classList.add("toast-show");
      }, 10);

      // Remove after 3 seconds
      setTimeout(() => {
        toast.classList.remove("toast-show");
        toast.classList.add("toast-enter");
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }

    window.onload = function() {
      loadState();
      initCategoryDropdowns();
      initReflectionFields();
      setupExportHandlers();
      setupModalAndTheme();
      
      updateCountdown();
      renderCanvasStats();
      renderCategoryPills();
      renderGoals();

      // Search & Filter listeners
      document.getElementById("search-input").addEventListener("input", renderGoals);
      document.getElementById("category-filter").addEventListener("change", renderGoals);
      document.getElementById("status-filter").addEventListener("change", renderGoals);

      // Window resize re-renders canvas stats
      window.addEventListener("resize", renderCanvasStats);
    };
  </script>
</body>
