<!DOCTYPE html>
<html lang="zh-TW" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>邁向 2027：100 項人生必做清單與年度盤點</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- html2pdf.js CDN for PDF export -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  
  <!-- FontAwesome Icons CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Google Fonts (Noto Sans TC & Inter) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Sans+TC:wght@300;400;500;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0f9ff',
              100: '#e0f2fe',
              500: '#0284c7',
              600: '#0369a1',
              700: '#075985',
              900: '#0c4a6e',
            }
          },
          fontFamily: {
            sans: ['Inter', 'Noto Sans TC', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <style>
    body {
      font-family: 'Inter', 'Noto Sans TC', sans-serif;
    }
    
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: rgba(0,0,0,0.05);
      border-radius: 8px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: rgba(156, 163, 175, 0.5);
      border-radius: 8px;
    }
    
    /* PDF Print and Export Styles */
    @media print {
      .no-print {
        display: none !important;
      }
      .print-only {
        display: block !important;
      }
      body {
        background: white !important;
        color: black !important;
      }
    }
    
    .print-only {
      display: none;
    }

    /* Toast animation styles */
    .toast-enter {
      transform: translateY(-100%);
      opacity: 0;
    }
    .toast-show {
      transform: translateY(0);
      opacity: 1;
    }
  </style>
</head>

<body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 min-h-full flex flex-col transition-colors duration-200">

  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col space-y-2 pointer-events-none"></div>

  <!-- Confetti Canvas -->
  <canvas id="confetti-canvas" class="fixed inset-0 pointer-events-none z-50"></canvas>

  <!-- Navigation Header -->
  <header class="bg-white/80 dark:bg-slate-800/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-700 sticky top-0 z-30 no-print">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center text-white shadow-md font-bold text-lg">
          27
        </div>
        <div>
          <h1 class="text-lg font-bold bg-gradient-to-r from-sky-600 to-indigo-600 dark:from-sky-400 dark:to-indigo-400 bg-clip-text text-transparent">
            2027 年前必做 100 件事
          </h1>
          <p class="text-xs text-slate-500 dark:text-slate-400">人生願景畫布與目標追蹤系統</p>
        </div>
      </div>

      <!-- Header Actions -->
      <div class="flex items-center space-x-2 sm:space-x-3">
        <!-- Theme Toggle -->
        <button id="theme-toggle" class="p-2 text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg transition" title="切換深淺模式">
          <i class="fa-solid fa-moon dark:hidden"></i>
          <i class="fa-solid fa-sun hidden dark:block text-amber-400"></i>
        </button>

        <!-- Backup Data -->
        <button id="btn-export-json" class="p-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg text-sm flex items-center space-x-1" title="下載 JSON 備份檔">
          <i class="fa-solid fa-download"></i>
          <span class="hidden md:inline">備份</span>
        </button>
        <button id="btn-import-json" class="p-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg text-sm flex items-center space-x-1" title="匯入 JSON 備份檔">
          <i class="fa-solid fa-upload"></i>
          <span class="hidden md:inline">匯入</span>
        </button>
        <input type="file" id="input-import-file" class="hidden" accept=".json">

        <!-- Download PDF -->
        <button id="btn-export-pdf" class="px-3.5 py-2 bg-gradient-to-r from-sky-500 to-indigo-600 hover:from-sky-600 hover:to-indigo-700 text-white font-medium rounded-xl text-sm shadow-md transition flex items-center space-x-1.5">
          <i class="fa-solid fa-file-pdf"></i>
          <span>下載 PDF 報告</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8" id="export-container">
    
    <!-- Printable Header Banner (Only visible in PDF export) -->
    <div class="print-only mb-6 border-b pb-4">
      <h1 class="text-3xl font-bold text-slate-900">2027年前 100 項必做事項與盤點報告</h1>
      <p class="text-sm text-slate-600 mt-1">匯出日期：<span id="pdf-export-date"></span> | 整體完成進度：<span id="pdf-export-progress">0%</span></p>
    </div>

    <!-- Dashboard Header Visualizer / Canvas Stats -->
    <section class="bg-white dark:bg-slate-800 rounded-2xl p-6 shadow-sm border border-slate-200/80 dark:border-slate-700/80">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-center">
        
        <!-- Interactive Canvas Progress Circle -->
        <div class="flex flex-col items-center justify-center space-y-2">
          <div class="relative w-44 h-44 flex items-center justify-center">
            <canvas id="progress-canvas" width="180" height="180" class="w-44 h-44"></canvas>
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
              <span id="completion-percentage" class="text-3xl font-extrabold text-slate-800 dark:text-white">0%</span>
              <span id="completion-count-text" class="text-xs font-medium text-slate-500 dark:text-slate-400 mt-0.5">0 / 100 已完成</span>
            </div>
          </div>
        </div>

        <!-- Progress Overview Info -->
        <div class="space-y-4 lg:col-span-2">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-sky-100 text-sky-800 dark:bg-sky-900/50 dark:text-sky-300">
                目標期限：2026 年 12 月 31 日前
              </span>
              <h2 class="text-xl font-bold text-slate-800 dark:text-white mt-2">走向 2027 的 100 個全方位行動計畫</h2>
            </div>
            <div class="text-right">
              <span class="text-xs text-slate-500 dark:text-slate-400">距離 2027 年倒數</span>
              <div id="countdown-days" class="text-2xl font-black text-indigo-600 dark:text-indigo-400">--- 天</div>
            </div>
          </div>

          <!-- Progress Bars by Status -->
          <div class="space-y-2">
            <div class="flex justify-between text-xs font-medium text-slate-600 dark:text-slate-400">
              <span>整體執行進度條</span>
              <span id="progress-text-detail">已達成 0 項，剩餘 100 項</span>
            </div>
            <div class="w-full bg-slate-100 dark:bg-slate-700 h-3 rounded-full overflow-hidden flex">
              <div id="main-progress-bar" class="bg-gradient-to-r from-sky-500 to-indigo-600 h-full transition-all duration-500" style="width: 0%"></div>
            </div>
          </div>

          <!-- Category Quick Breakdown Pills -->
          <div id="category-pills" class="flex flex-wrap gap-1.5 pt-2">
            <!-- Dynamic Category Pills inserted here -->
          </div>
        </div>

      </div>
    </section>

    <!-- Toolbar: Search, Filters & Action -->
    <section class="bg-white dark:bg-slate-800 rounded-2xl p-4 shadow-sm border border-slate-200/80 dark:border-slate-700/80 space-y-4 no-print">
      <div class="flex flex-col md:flex-row gap-4 justify-between items-stretch md:items-center">
        
        <!-- Search -->
        <div class="relative flex-grow max-w-md">
          <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
          <input type="text" id="search-input" placeholder="搜尋事項、關鍵字、心得..." class="w-full pl-9 pr-4 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 transition">
        </div>

        <!-- Filter Controls -->
        <div class="flex flex-wrap items-center gap-2">
          <!-- Category Dropdown -->
          <select id="category-filter" class="px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 transition">
            <option value="ALL">全部領域 (10大類別)</option>
            <!-- Categories options populated via JS -->
          </select>

          <!-- Status Dropdown -->
          <select id="status-filter" class="px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 transition">
            <option value="ALL">全部狀態</option>
            <option value="PENDING">未完成</option>
            <option value="COMPLETED">已打勾完成</option>
          </select>

          <!-- Add Custom Goal Button -->
          <button id="btn-add-custom" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 rounded-xl text-sm font-medium transition flex items-center space-x-1">
            <i class="fa-solid fa-plus text-xs"></i>
            <span>自訂項目</span>
          </button>
        </div>

      </div>
    </section>

    <!-- Checklist Canvas Section -->
    <section class="space-y-4">
      <div class="flex items-center justify-between px-1">
        <h3 class="text-lg font-bold text-slate-800 dark:text-white flex items-center space-x-2">
          <span>百項修煉清單列表</span>
          <span id="filtered-count" class="text-xs bg-slate-200 dark:bg-slate-700 px-2 py-0.5 rounded-full text-slate-600 dark:text-slate-300">100</span>
        </h3>
        <div class="text-xs text-slate-500 dark:text-slate-400">
          勾選即可自動帶入今日日期，並可寫下體驗心得
        </div>
      </div>

      <!-- The Grid of 100 Items -->
      <div id="goals-container" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Goal items injected dynamically -->
      </div>
    </section>

    <!-- Year-End 2027 Reflection Canvas Section -->
    <section class="bg-gradient-to-br from-indigo-900 via-slate-900 to-slate-900 text-white rounded-2xl p-6 md:p-8 shadow-xl space-y-6">
      <div class="border-b border-indigo-500/30 pb-4 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <span class="inline-block px-3 py-1 bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 text-xs font-semibold rounded-full mb-2">
            Annual Reflection Canvas
          </span>
          <h2 class="text-2xl font-bold flex items-center gap-2">
            <i class="fa-solid fa-feather-pointed text-indigo-400"></i>
            <span>2027 年底總結與盤點心得寫作畫布</span>
          </h2>
          <p class="text-sm text-slate-300 mt-1">
            當時間來到 2026 年底與 2027 年初，請在此靜心寫下您的回顧、感悟與成果盤點。
          </p>
        </div>
        <div class="text-xs bg-white/10 px-3 py-2 rounded-xl backdrop-blur-sm self-start md:self-auto text-slate-300">
          <i class="fa-solid fa-floppy-disk mr-1 text-emerald-400"></i> 內容將自動即時儲存
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Reflection Field 1: Top 3 Achievements -->
        <div class="space-y-2 bg-white/5 p-4 rounded-xl border border-white/10">
          <label class="block text-sm font-semibold text-indigo-200 flex items-center gap-2">
            <i class="fa-solid fa-trophy text-amber-400"></i>
            <span>1. 這幾年中最令自己驕傲的 3 大成就或突破：</span>
          </label>
          <textarea id="reflection-achievements" rows="4" placeholder="例如：完成了第一次半程馬拉松、建立穩定的副業被動收入、帶父母去了日本旅遊..." class="w-full bg-slate-950/60 border border-slate-700 rounded-xl p-3 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 custom-scrollbar"></textarea>
        </div>

        <!-- Reflection Field 2: Insights and Learning -->
        <div class="space-y-2 bg-white/5 p-4 rounded-xl border border-white/10">
          <label class="block text-sm font-semibold text-indigo-200 flex items-center gap-2">
            <i class="fa-solid fa-lightbulb text-yellow-300"></i>
            <span>2. 未完成事項的原因分析與最寶貴的學習體悟：</span>
          </label>
          <textarea id="reflection-learnings" rows="4" placeholder="記錄那些未完成的項目帶來了什麼啟示？學會了如何重新調整優先順序與心態..." class="w-full bg-slate-950/60 border border-slate-700 rounded-xl p-3 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 custom-scrollbar"></textarea>
        </div>

        <!-- Reflection Field 3: Letter to Future Self -->
        <div class="space-y-2 bg-white/5 p-4 rounded-xl border border-white/10 md:col-span-2">
          <label class="block text-sm font-semibold text-indigo-200 flex items-center gap-2">
            <i class="fa-solid fa-envelope-open-text text-sky-400"></i>
            <span>3. 站在 2027 年的起點，給未來的自己一封信與總體心得：</span>
          </label>
          <textarea id="reflection-letter" rows="5" placeholder="寫給迎向全新階段的自己... 感謝這幾年來堅持不懈的努力，未來的我準備好了！" class="w-full bg-slate-950/60 border border-slate-700 rounded-xl p-3 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 custom-scrollbar"></textarea>
        </div>

      </div>
    </section>

  </main>

  <!-- Add Custom Goal Modal -->
  <div id="modal-add" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden no-print">
    <div class="bg-white dark:bg-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 dark:border-slate-700 space-y-4">
      <div class="flex justify-between items-center border-b border-slate-200 dark:border-slate-700 pb-3">
        <h3 class="text-lg font-bold text-slate-800 dark:text-white">新增自訂必做事項</h3>
        <button id="btn-close-modal" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>

      <div class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">領域類別</label>
          <select id="modal-category" class="w-full p-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm">
            <!-- Categories injected by JS -->
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">目標項目內容</label>
          <input type="text" id="modal-title" placeholder="例如：學會做特調手沖咖啡..." class="w-full p-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-sky-500">
        </div>
      </div>

      <div class="flex justify-end space-x-2 pt-2">
        <button id="btn-cancel-modal" class="px-4 py-2 text-sm text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-xl">取消</button>
        <button id="btn-save-custom" class="px-4 py-2 text-sm font-medium bg-sky-600 hover:bg-sky-700 text-white rounded-xl shadow-md transition">確認新增</button>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="bg-white dark:bg-slate-800 border-t border-slate-200 dark:border-slate-700 py-6 mt-12 no-print">
    <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-500 dark:text-slate-400 space-y-1">
      <p>邁向 2027 年願景畫布與目標實踐系統 | 隨時瀏覽、紀錄與回顧</p>
      <p class="text-slate-400 dark:text-slate-500">所有資料均自動加密安全儲存於您的本機瀏覽器中</p>
    </div>
  </footer>

  <!-- JavaScript Application Logic -->
