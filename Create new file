      }
    };

    const STORAGE_KEY = "GOALS_2027_STATE_V2";

    function loadState() {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        try {
          state = JSON.parse(saved);
        } catch(e) {
          console.error("Failed to parse saved state", e);
          initDefaultState();
        }
      } else {
        initDefaultState();
      }
    }

    function initDefaultState() {
      state.goals = DEFAULT_GOALS.map(g => ({
        ...g,
        completed: false,
        completedDate: "",
        note: ""
      }));
      state.reflections = { achievements: "", learnings: "", letter: "" };
      saveState();
    }

    function saveState() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      renderCanvasStats();
      renderCategoryPills();
    }

    function renderCanvasStats() {
      const canvas = document.getElementById("progress-canvas");
      if (!canvas) return;
      const ctx = canvas.getContext("2d");
      const width = canvas.width;
      const height = canvas.height;
      
      const total = state.goals.length;
      const completedCount = state.goals.filter(g => g.completed).length;
      const percentage = total > 0 ? Math.round((completedCount / total) * 100) : 0;

      // Update Text Displays
      document.getElementById("completion-percentage").innerText = `${percentage}%`;
      document.getElementById("completion-count-text").innerText = `${completedCount} / ${total} 已完成`;
      document.getElementById("progress-text-detail").innerText = `已達成 ${completedCount} 項，剩餘 ${total - completedCount} 項`;
      document.getElementById("main-progress-bar").style.width = `${percentage}%`;

      // Clear Canvas
      ctx.clearRect(0, 0, width, height);

      const centerX = width / 2;
      const centerY = height / 2;
      const radius = 70;
      const lineWidth = 14;

      // Draw Background Track Ring
      ctx.beginPath();
      ctx.arc(centerX, centerY, radius, 0, Math.PI * 2);
      ctx.strokeStyle = document.documentElement.classList.contains('dark') ? '#334155' : '#f1f5f9';
      ctx.lineWidth = lineWidth;
      ctx.lineCap = 'round';
      ctx.stroke();

      // Draw Progress Arc
      if (percentage > 0) {
        const startAngle = -Math.PI / 2;
        const endAngle = startAngle + (Math.PI * 2 * (percentage / 100));

        const gradient = ctx.createLinearGradient(0, 0, width, height);
        gradient.addColorStop(0, '#0284c7'); // sky-600
        gradient.addColorStop(1, '#4f46e5'); // indigo-600

        ctx.beginPath();
        ctx.arc(centerX, centerY, radius, startAngle, endAngle);
        ctx.strokeStyle = gradient;
        ctx.lineWidth = lineWidth;
        ctx.lineCap = 'round';
        ctx.stroke();
      }
    }

    function updateCountdown() {
      const targetDate = new Date("2027-01-01T00:00:00");
      const now = new Date();
      const diffTime = targetDate - now;
      const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
      
      const daysElem = document.getElementById("countdown-days");
      if (daysElem) {
        daysElem.innerText = diffDays > 0 ? `${diffDays} 天` : "已邁入 2027！";
      }
    }

    function renderCategoryPills() {
      const container = document.getElementById("category-pills");
      if (!container) return;

      container.innerHTML = "";

      Object.keys(CATEGORIES).forEach(catKey => {
        const cat = CATEGORIES[catKey];
        const count = state.goals.filter(g => g.category === catKey).length;
        const compCount = state.goals.filter(g => g.category === catKey && g.completed).length;

        const pill = document.createElement("div");
        pill.className = `text-[11px] px-2.5 py-1 rounded-lg font-medium flex items-center gap-1.5 border cursor-pointer transition hover:opacity-80 ${cat.color}`;
        pill.innerHTML = `
          <i class="fa-solid ${cat.icon}"></i>
          <span>${cat.name}</span>
          <span class="font-bold">(${compCount}/${count})</span>
        `;
        pill.onclick = () => {
          document.getElementById("category-filter").value = catKey;
          renderGoals();
        };
        container.appendChild(pill);
      });
    }

    function renderGoals() {
      const container = document.getElementById("goals-container");
      if (!container) return;

      const searchTerm = document.getElementById("search-input").value.toLowerCase();
      const categoryFilter = document.getElementById("category-filter").value;
      const statusFilter = document.getElementById("status-filter").value;

      const filtered = state.goals.filter(goal => {
        const matchesSearch = goal.title.toLowerCase().includes(searchTerm) || (goal.note && goal.note.toLowerCase().includes(searchTerm));
        const matchesCategory = categoryFilter === "ALL" || goal.category === categoryFilter;
        let matchesStatus = true;
        if (statusFilter === "PENDING") matchesStatus = !goal.completed;
        if (statusFilter === "COMPLETED") matchesStatus = goal.completed;

        return matchesSearch && matchesCategory && matchesStatus;
      });

      document.getElementById("filtered-count").innerText = `${filtered.length} / ${state.goals.length}`;

      container.innerHTML = "";

      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="col-span-full text-center py-12 bg-white dark:bg-slate-800 rounded-2xl border border-dashed border-slate-300 dark:border-slate-700">
